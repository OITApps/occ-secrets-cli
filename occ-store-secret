#!/usr/bin/env python3
"""
occ-store-secret — Interactively store a secret in Azure Key Vault.

Cross-platform companion to occ-fetch-secret. Prompts for vault + secret
name, reads the secret value with hidden input (getpass), writes via
`az keyvault secret set`. Auto-normalizes FOO_BAR → FOO-BAR.

Outputs status to stderr; nothing to stdout (the value is never echoed).
"""
from __future__ import annotations

import argparse
import getpass
import json
import os
import subprocess
import sys
from pathlib import Path

CONFIG_PATH = Path.home() / ".claude" / ".occ-vault.json"


def err(msg: str) -> None:
    print(msg, file=sys.stderr)


def run_az(*args: str, capture: bool = True, check: bool = True, stdin: bytes | None = None) -> str:
    env = os.environ.copy()
    admin = Path.home() / ".azure-admin"
    if admin.is_dir():
        probe = subprocess.run(
            ["az", "account", "show", "-o", "none"],
            env={**env, "AZURE_CONFIG_DIR": str(admin)},
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        if probe.returncode == 0:
            env["AZURE_CONFIG_DIR"] = str(admin)
    cmd = ["az", *args]
    r = subprocess.run(cmd, env=env, capture_output=capture, text=False, input=stdin)
    if check and r.returncode != 0:
        msg = (r.stderr or b"").decode("utf-8", errors="replace").strip()
        raise RuntimeError(msg)
    return (r.stdout or b"").decode("utf-8", errors="replace").strip()


def resolve_user_vault() -> str:
    # Precedence: env var (temp override) > config file > derived from az login.
    env = os.environ.get("OCC_USER_VAULT")
    if env:
        return env
    if CONFIG_PATH.is_file():
        try:
            cfg = json.loads(CONFIG_PATH.read_text())
            if cfg.get("userVault"):
                return cfg["userVault"]
        except Exception:
            pass
    upn = run_az("account", "show", "--query", "user.name", "-o", "tsv")
    if "@" in upn:
        upn = upn.split("@", 1)[0]
    if not upn:
        raise RuntimeError("could not derive user vault; set OCC_USER_VAULT or write ~/.claude/.occ-vault.json")
    return f"occ-secrets-{upn}"


def resolve_vault_name(shorthand: str) -> str:
    if shorthand == "user":
        return resolve_user_vault()
    if shorthand == "company":
        return "occ-secrets-company"
    if shorthand == "bot":
        return "occ-secrets-bots"
    raise SystemExit(f"unknown vault shorthand '{shorthand}'. Use: user, company, bot")


def pick_vault() -> str:
    err("Select vault:")
    err("  1) user    (occ-secrets-<you>)")
    err("  2) bot     (occ-secrets-bots)")
    err("  3) company (occ-secrets-company)")
    err("Choice [1-3]: ")
    try:
        choice = input().strip()
    except EOFError:
        raise SystemExit("no input available — run interactively or pass --vault")
    return {"1": "user", "2": "bot", "3": "company"}.get(choice) or sys.exit(f"invalid choice '{choice}'")


def main() -> int:
    ap = argparse.ArgumentParser(description="Store a secret in Azure Key Vault (interactive value entry).")
    ap.add_argument("--vault", choices=["user", "company", "bot"], help="Vault shorthand (interactive if omitted)")
    ap.add_argument("--name", action="append", help="Secret name. Repeatable. Interactive if omitted.")
    args = ap.parse_args()

    if subprocess.run(["az", "--version"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode != 0:
        err("az CLI not installed. See https://aka.ms/azure-cli for install instructions.")
        return 1

    shorthand = args.vault or (pick_vault() if sys.stdin.isatty() else None)
    if not shorthand:
        err("no --vault and no TTY — pass --vault.")
        return 1
    names = args.name or []

    if not names:
        if not sys.stdin.isatty():
            err("--name omitted and no TTY — pass --name.")
            return 1
        err("Secret name (e.g. FIREFLIES-API-KEY): ")
        first = input().strip()
        if not first:
            err("name cannot be empty")
            return 1
        names = [first]

    try:
        run_az("account", "show", capture=True, check=True)
    except RuntimeError:
        err("az login required: run `az login` against your OIT identity, then retry.")
        return 1

    vault_name = resolve_vault_name(shorthand)
    stored = failed = 0

    for original in names:
        normalized = original.replace("_", "-")
        try:
            value = getpass.getpass(prompt=f"Enter value for {original}: ")
        except (KeyboardInterrupt, EOFError):
            err("\naborted.")
            return 1
        if not value:
            err(f"  SKIP — empty value for {original}")
            failed += 1
            continue
        try:
            run_az(
                "keyvault", "secret", "set",
                "--vault-name", vault_name,
                "--name", normalized,
                "--value", value,
                "-o", "none",
            )
            err(f"  OK — {original} → {vault_name}/{normalized}")
            stored += 1
        except RuntimeError as e:
            err(f"  FAIL — {original}: {e}")
            failed += 1

    err("")
    err(f"Done: {stored} stored, {failed} failed (vault: {vault_name})")
    return 0 if failed == 0 else 1


if __name__ == "__main__":
    sys.exit(main())
