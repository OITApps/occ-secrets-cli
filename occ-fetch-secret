#!/usr/bin/env python3
"""
occ-fetch-secret — Interactively fetch a single secret from Azure Key Vault.

Cross-platform (macOS, Linux, Windows). Lightweight: this is the standalone
version shipped via occ-secrets-cli/install.sh|install.ps1 for users who
don't have full OCC installed.

Outputs the secret value to stdout. Status messages go to stderr — safe to
pipe into other commands (e.g. clip, pbcopy, set-clipboard).
"""
from __future__ import annotations

import argparse
import json
import os
import platform
import re
import subprocess
import sys
from pathlib import Path

CONFIG_PATH = Path.home() / ".claude" / ".occ-vault.json"


def err(msg: str) -> None:
    print(msg, file=sys.stderr)


def run_az(*args: str, capture: bool = True, check: bool = True) -> str:
    """Run az with the appropriate AZURE_CONFIG_DIR."""
    env = os.environ.copy()
    admin = Path.home() / ".azure-admin"
    if admin.is_dir():
        probe = subprocess.run(
            ["az", "account", "show", "-o", "none"],
            env={**env, "AZURE_CONFIG_DIR": str(admin)},
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        if probe.returncode == 0:
            env["AZURE_CONFIG_DIR"] = str(admin)
    cmd = ["az", *args]
    if capture:
        r = subprocess.run(cmd, env=env, capture_output=True, text=True)
    else:
        r = subprocess.run(cmd, env=env, text=True)
    if check and r.returncode != 0:
        raise RuntimeError(r.stderr.strip() if capture else f"az exited {r.returncode}")
    return r.stdout.strip() if capture else ""


def resolve_user_vault() -> str:
    # Precedence: env var (temp override) > config file > derived from az login.
    env = os.environ.get("OCC_USER_VAULT")
    if env:
        return env
    if CONFIG_PATH.is_file():
        try:
            cfg = json.loads(CONFIG_PATH.read_text())
            if cfg.get("userVault"):
                return cfg["userVault"]
        except Exception:
            pass
    upn = run_az("account", "show", "--query", "user.name", "-o", "tsv")
    if "@" in upn:
        upn = upn.split("@", 1)[0]
    if not upn:
        raise RuntimeError("could not derive user vault; set OCC_USER_VAULT or write ~/.claude/.occ-vault.json")
    return f"occ-secrets-{upn}"


def resolve_vault_name(shorthand: str) -> str:
    if shorthand == "user":
        return resolve_user_vault()
    if shorthand == "company":
        return "occ-secrets-company"
    if shorthand == "bot":
        return "occ-secrets-bots"
    raise SystemExit(f"unknown vault shorthand '{shorthand}'. Use: user, company, bot")


def pick_vault() -> str:
    err("Select vault:")
    err("  1) user    (occ-secrets-<you>)")
    err("  2) bot     (occ-secrets-bots)")
    err("  3) company (occ-secrets-company)")
    err("Choice [1-3]: ")
    try:
        choice = input().strip()
    except EOFError:
        raise SystemExit("no input available — run interactively or pass --vault")
    return {"1": "user", "2": "bot", "3": "company"}.get(choice) or sys.exit(f"invalid choice '{choice}'")


def list_secrets(vault_name: str) -> list[str]:
    out = run_az(
        "keyvault", "secret", "list",
        "--vault-name", vault_name,
        "--query", "[?attributes.enabled].name",
        "-o", "tsv",
    )
    return sorted([s for s in out.splitlines() if s.strip()])


def pick_secret(vault_name: str) -> str:
    secrets = list_secrets(vault_name)
    if not secrets:
        raise SystemExit(f"no enabled secrets in {vault_name} (or no read access)")
    err(f"Secrets in {vault_name} ({len(secrets)} total):")
    for i, s in enumerate(secrets, start=1):
        err(f"  {i:3d}) {s}")
    err(f"Choice [1-{len(secrets)}] (or partial name to filter): ")
    choice = input().strip()
    if choice.isdigit() and 1 <= int(choice) <= len(secrets):
        return secrets[int(choice) - 1]
    needle = choice.lower()
    matches = [s for s in secrets if needle in s.lower()]
    if not matches:
        raise SystemExit(f"no secret matches '{choice}'")
    if len(matches) == 1:
        return matches[0]
    err(f"Matches for '{choice}':")
    for i, m in enumerate(matches, start=1):
        err(f"  {i:3d}) {m}")
    err(f"Choice [1-{len(matches)}]: ")
    c2 = input().strip()
    if c2.isdigit() and 1 <= int(c2) <= len(matches):
        return matches[int(c2) - 1]
    raise SystemExit(f"invalid choice '{c2}'")


def fetch_value(vault_name: str, secret_name: str) -> str:
    return run_az(
        "keyvault", "secret", "show",
        "--vault-name", vault_name,
        "--name", secret_name,
        "--query", "value",
        "-o", "tsv",
    )


def copy_to_clipboard(value: str) -> None:
    """Cross-platform clipboard copy without external deps."""
    system = platform.system()
    if system == "Darwin":
        p = subprocess.Popen(["pbcopy"], stdin=subprocess.PIPE)
    elif system == "Windows":
        p = subprocess.Popen(["clip"], stdin=subprocess.PIPE)
    elif system == "Linux":
        for cmd in (["wl-copy"], ["xclip", "-selection", "clipboard"], ["xsel", "-bi"]):
            try:
                p = subprocess.Popen(cmd, stdin=subprocess.PIPE)
                break
            except FileNotFoundError:
                continue
        else:
            raise SystemExit("no clipboard tool found — install wl-copy, xclip, or xsel")
    else:
        raise SystemExit(f"unsupported platform: {system}")
    p.communicate(value.encode("utf-8"))
    if p.returncode != 0:
        raise SystemExit("clipboard copy failed")


def main() -> int:
    ap = argparse.ArgumentParser(description="Fetch a single secret from Azure Key Vault.")
    ap.add_argument("--vault", choices=["user", "company", "bot"], help="Vault shorthand (interactive if omitted)")
    ap.add_argument("--name", help="Secret name (interactive numbered selector if omitted)")
    ap.add_argument("--list", action="store_true", help="Print secret names in the vault and exit")
    ap.add_argument("--copy", action="store_true", help="Copy fetched value to clipboard; nothing to stdout")
    args = ap.parse_args()

    if subprocess.run(["az", "--version"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode != 0:
        err("az CLI not installed. See https://aka.ms/azure-cli for install instructions.")
        return 1

    shorthand = args.vault or (pick_vault() if sys.stdin.isatty() else None)
    if not shorthand:
        err("no --vault and no TTY — pass --vault.")
        return 1

    try:
        run_az("account", "show", capture=True, check=True)
    except RuntimeError:
        err("az login required: run `az login` against your OIT identity, then retry.")
        return 1

    vault_name = resolve_vault_name(shorthand)

    if args.list:
        try:
            for s in list_secrets(vault_name):
                print(s)
            return 0
        except RuntimeError as e:
            err(f"could not list {vault_name}: {e}")
            return 1

    secret_name = args.name
    if not secret_name:
        if not sys.stdin.isatty():
            err("--name omitted and no TTY — pass --name.")
            return 1
        secret_name = pick_secret(vault_name)
    secret_name = secret_name.replace("_", "-")

    try:
        value = fetch_value(vault_name, secret_name)
    except RuntimeError as e:
        err(f"could not fetch {vault_name}/{secret_name}: {e}")
        return 1

    err(f"  OK — {vault_name}/{secret_name} ({len(value)} chars)")

    if args.copy:
        copy_to_clipboard(value)
        err("  copied to clipboard")
    else:
        print(value)
    return 0


if __name__ == "__main__":
    sys.exit(main())
